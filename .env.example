# The Studio Archive (skypistudio.com/archive) — Supabase configuration.
#
# RLS is the security boundary and the anon (publishable) key is public by
# design, so these are safe to expose in the client bundle. For the GitHub Pages
# deploy, set BOTH as repository **Variables** (Settings → Secrets and variables
# → Actions → Variables) so the build step can inline them. For local dev/build,
# copy this file to `.env.local` and fill in the real values.
#
# Never put the service_role key anywhere in this repo.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
