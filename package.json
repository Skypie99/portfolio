{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "defaults",
    "not dead",
    "not op_mini all"
  ],
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/validate-assets.mjs",
    "build": "next build",
    "postbuild": "node scripts/prune-500.mjs && node scripts/og-png-alias.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:static": "npm run build && vitest run lib/__tests__/static-integrity.test.ts lib/__tests__/section-nav-anchors.test.ts",
    "check:overflow": "node scripts/overflow-census.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.112.2",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.0",
    "gsap": "^3.15.0",
    "next": "15.5.18",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.11.4",
    "eslint": "^8",
    "eslint-config-next": "15.5.18",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.61.1",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
