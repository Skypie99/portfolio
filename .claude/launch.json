{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "portfolio-out",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "3005", "--directory", "out"],
      "port": 3005,
      "autoPort": true
    }
  ]
}
